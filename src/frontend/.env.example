# Copy this file to .env.local for local development.
# Vite exposes only variables prefixed with VITE_ to the browser.

# Base URL for the workflow API (defaults to /api/workflow via Vite proxy)
VITE_API_BASE_URL=http://localhost:5072/api/workflow

# API key for X-Api-Key authentication.
# Must match Authentication:ApiKey in appsettings.Development.json.
VITE_API_KEY=dev-api-key-change-in-production
