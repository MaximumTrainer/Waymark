# Copy this file to .env.local for local development.
# Vite exposes only variables prefixed with VITE_ to the browser, and inlines them into the built
# bundle as literal strings. Never put a credential here: anything in this file is readable by
# every visitor who loads the app.

# Base URL for the backend host (the app will append /api/workflow automatically)
VITE_API_BASE_URL=http://localhost:5072

# Authentication needs no configuration here:
#  - The public onboarding journey starts anonymously. POST /api/workflow/sessions/start returns an
#    applicant token scoped to that one session, which the app sends for every later request.
#  - Operator screens authenticate with the AdminSession cookie from SAML SSO (/auth/saml/login).
#  - Authentication:ApiKey is a server-to-server credential and must never be sent from a browser:
#    it maps to a full Operator principal.
