{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "OnboardingDb": "Host=localhost;Port=5432;Database=onboarding;Username=postgres;Password=postgres"
  },
  "Authentication": {
    "JwtAuthority": "",
    "JwtAudience": "open-onboarding-api",
    "ApiKey": "dev-api-key-change-in-production",
    "ApplicantToken": {
      "SigningKey": "",
      "LifetimeMinutes": 0
    },
    "Saml": {
      "Issuer": "waymark-service-provider",
      "AcsUrl": "",
      "RelayStateTimeoutMinutes": 5,
      "SessionDurationHours": 8
    }
  },
  "SessionTimeoutMinutes": 1440,
  "Analytics": {
    "ConsoleProvider": { "Enabled": true },
    "DatabaseProvider": { "Enabled": true },
    "RetentionDays": 365,
    "CleanupIntervalHours": 24
  },
  "DocumentUpload": {
    "MaxFileSizeBytes": 10485760
  },
  "RateLimiting": {
    "SessionStartPerMinute": 100,
    "WebhookRegistrationPerMinute": 20,
    "GeneralPerMinute": 300,
    "AnalyticsIngestPerMinute": 120
  },
  "VirusScan": {
    "Enabled": false,
    "Host": "clamav",
    "Port": 3310,
    "TimeoutSeconds": 30
  },
  "AllowedHosts": "*"
}
